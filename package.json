{
  "name": "ebeam-reticle-repair",
  "version": "1.0.0",
  "description": "半导体掩膜版电子束修复系统 - Electron + React + OpenCV C++ Node-API",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run build:dev\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:8080 && cross-env NODE_ENV=development electron .",
    "build:dev": "webpack serve --mode development --config webpack.config.js",
    "build": "webpack --mode production --config webpack.config.js",
    "build:native": "node-gyp rebuild",
    "setup:check": "node scripts/install-native-deps.js",
    "sample:generate": "node scripts/generate-sample-image.js"
  },
  "keywords": [
    "electron",
    "react",
    "opencv",
    "semiconductor",
    "ebeam",
    "reticle",
    "node-api"
  ],
  "author": "Semiconductor Equipment R&D",
  "license": "UNLICENSED",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.160.0",
    "bindings": "^1.5.0",
    "node-addon-api": "^7.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "electron": "^28.0.0",
    "html-webpack-plugin": "^5.6.0",
    "node-gyp": "^10.0.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "wait-on": "^7.2.0"
  }
}
